# Alpaca API Credentials
# Get your keys from https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Use paper trading endpoint (set to 'live' for real trading)
ALPACA_TRADING_MODE=paper

# NTFY
NTFY_USERNAME="your_username"
NTFY_PASSWORD="your_password"
NTFY_SERVER_URL="https://ntfy.example.com/"

# Risk Management
RISK_MAX_POSITION_PCT=20          # Max single position as % of portfolio
RISK_MAX_PORTFOLIO_RISK_PCT=2     # Max % of portfolio risked per trade (for position sizing)
RISK_MAX_DAILY_LOSS_PCT=3         # Daily loss limit as % of equity
RISK_MAX_DRAWDOWN_PCT=10          # Max drawdown from peak equity
RISK_STOP_LOSS_MODE=advisory      # "advisory" or "active"

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alpaca
DB_USER=alpaca
DB_PASSWORD=changeme

# Webhook Security
WEBHOOK_SECRET=your_random_secret_here